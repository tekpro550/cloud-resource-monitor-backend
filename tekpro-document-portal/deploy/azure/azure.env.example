# Settings for deploy/azure/deploy.sh. Copy to azure.env (git-ignored) and fill in.
# Use single quotes around values containing spaces or special characters.

# --- Azure ---------------------------------------------------------------------
RESOURCE_GROUP=tekpro-portal-rg
LOCATION=centralindia                 # az account list-locations -o table
NAME_PREFIX=tekpro                    # lowercase, max 12 characters
ACR_NAME=tekproportalacr              # globally unique, 5-50 lowercase letters/digits
MIN_REPLICAS=1
MAX_REPLICAS=3

# Public URL. Leave empty to use the default https://tekpro-portal.<env>.<region>.azurecontainerapps.io
# Set it after adding a custom domain (see docs/AZURE_DEPLOYMENT.md), then redeploy.
APP_BASE_URL=

# --- Database (Azure Database for PostgreSQL Flexible Server is created) ----------
POSTGRES_ADMIN_LOGIN=portaladmin
POSTGRES_ADMIN_PASSWORD=''            # 12+ chars, upper/lower/digit/symbol
# To use an existing database instead, set CREATE_DATABASE=false and DATABASE_URL (with sslmode=require)
CREATE_DATABASE=true
DATABASE_URL=

# --- Application secrets ---------------------------------------------------------
# Generated automatically on the first run and written back to this file if empty.
SESSION_SECRET=

# --- Document storage (Amazon Lightsail bucket) ------------------------------------
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# --- Email (invitations and password resets) ----------------------------------------
MAIL_DRIVER=disabled                  # smtp | disabled
MAIL_FROM='Tekpro Document Portal <no-reply@example.com>'
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Show invitation links to the Super Admin (use only until email works).
ALLOW_ADMIN_RESET_LINKS=false

# --- Optional: customer-owned storage connectors ---------------------------------------
CONNECTOR_ENCRYPTION_KEY=
CONNECTOR_AWS_ACCESS_KEY_ID=
CONNECTOR_AWS_SECRET_ACCESS_KEY=
