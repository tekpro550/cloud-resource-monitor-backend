# Settings for the single-VM deployment (deploy/vm/docker-compose.yml).
# setup.sh copies this to .env (mode 600), generates the secrets and asks for the
# required values. Keep .env private and keep a copy somewhere safe: without
# SESSION_SECRET and POSTGRES_PASSWORD you cannot use the existing data.
# One KEY=value per line; no quotes needed; put comments on their own lines.

# --- Site --------------------------------------------------------------------------
# Public host name pointing at this VM, e.g. portal.tekpro.com or
# <label>.centralindia.cloudapp.azure.com (Azure VM DNS name label).
DOMAIN=
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=
# Application image (private Docker Hub repo: run `sudo docker login -u tekprocloud` first).
PORTAL_IMAGE=tekprocloud/tekpro-portal:1.0.0

# --- Secrets (generated by setup.sh) ------------------------------------------------
# Letters and digits only (it is part of the database URL).
POSTGRES_PASSWORD=
# Changing it signs everyone out.
SESSION_SECRET=

# --- Document storage (Amazon Lightsail bucket) ---------------------------------------
STORAGE_DRIVER=s3
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Email (invitations and password resets) -------------------------------------------
# smtp | disabled
MAIL_DRIVER=disabled
MAIL_FROM=Tekpro Document Portal <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Show invitation/reset links to admins on screen (use until email works).
ALLOW_ADMIN_RESET_LINKS=true

# --- Customer-owned storage connections (docs/STORAGE_CONNECTORS.md) -----------------
# Encrypts customer access keys at rest (generated by setup.sh). Keep it: if it changes,
# saved customer keys can no longer be read and must be entered again.
CONNECTOR_ENCRYPTION_KEY=
# CONNECTOR_AWS_ACCESS_KEY_ID=
# CONNECTOR_AWS_SECRET_ACCESS_KEY=

# --- Database backups (backup.sh, run nightly by setup.sh's cron entry) -----------------
BACKUP_RETENTION_DAYS=14
# Optional off-site copy. Use a SEPARATE bucket from STORAGE_BUCKET (the portal's storage
# reconciliation treats unknown objects in its bucket as strays) with its own access key.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups/
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
