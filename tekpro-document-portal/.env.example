# Tekpro Document Portal - server configuration
# Copy to `.env` (never commit it) or provide these as environment variables.
# The API validates this configuration at startup and refuses to start if a
# required value is missing or unsafe for production.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://portal:CHANGE_ME@localhost:5432/tekpro_portal?schema=public

# --- Sessions and web security -----------------------------------------------
# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Public URL of the portal (https:// is required in production). Used in email links and CORS.
APP_BASE_URL=http://localhost:5173
# Extra comma-separated origins allowed to call the API with credentials (APP_BASE_URL is always allowed).
CORS_ALLOWED_ORIGINS=
# Express "trust proxy" setting: number of proxy hops or a named range (loopback, uniquelocal, ...).
TRUST_PROXY=loopback
# Serve the built frontend from the API process (recommended single-origin deployment).
SERVE_FRONTEND_DIR=
SESSION_TTL_SECONDS=43200            # absolute session lifetime (12 h)
SESSION_IDLE_TIMEOUT_SECONDS=1800    # idle timeout (30 min)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX_REQUESTS=1000         # per IP per window, all API routes
RATE_LIMIT_LOGIN_MAX=20              # failed logins per IP per window
RATE_LIMIT_PASSWORD_RESET_MAX=5
PASSWORD_MIN_LENGTH=12
PASSWORD_RESET_TTL_SECONDS=1800
INVITE_TTL_SECONDS=259200

# --- Amazon Lightsail Object Storage (S3-compatible API) ---------------------
STORAGE_DRIVER=s3                    # only 's3' is valid outside automated tests
# Lightsail buckets use the regional S3 endpoint. Leave empty to let the SDK derive it,
# or set it explicitly, e.g. https://s3.ap-south-1.amazonaws.com
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=
# Lightsail bucket access key (Lightsail console > Storage > bucket > Permissions > Access keys).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
# Origin the browser uses for pre-signed requests (added to the CSP connect-src).
# Derived automatically as https://<bucket>.s3.<region>.amazonaws.com when empty.
STORAGE_PUBLIC_ORIGIN=
STORAGE_REQUEST_TIMEOUT_MS=30000

# --- Customer-owned storage connectors (optional) -----------------------------
# Lets a customer's documents live in a bucket the customer controls. See docs/STORAGE_CONNECTORS.md.
# Key that encrypts customer access keys at rest (32 bytes, base64): openssl rand -base64 32
# Required only for "access key" connectors; IAM-role connectors store no secrets.
# CONNECTOR_ENCRYPTION_KEY=
# Tekpro AWS credentials used ONLY to call sts:AssumeRole into customer roles.
# Leave unset to use the default AWS credential chain (e.g. an EC2 instance role).
# CONNECTOR_AWS_ACCESS_KEY_ID=
# CONNECTOR_AWS_SECRET_ACCESS_KEY=
# CONNECTOR_STS_REGION=us-east-1
# CONNECTOR_STS_ENDPOINT=                 # testing only (e.g. a local STS emulator)
# CONNECTOR_ROLE_SESSION_SECONDS=3600     # minimum 3600
# CONNECTOR_ALLOW_INSECURE_ENDPOINTS=false # development only; refused in production

# --- Uploads and downloads ---------------------------------------------------
UPLOAD_MAX_FILE_SIZE_BYTES=5368709120        # 5 GiB per file
UPLOAD_MULTIPART_THRESHOLD_BYTES=104857600   # files above 100 MiB use multipart upload
UPLOAD_PART_SIZE_BYTES=67108864              # 64 MiB parts (min 5 MiB; raised automatically for huge files)
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,xlsm,ppt,pptx,csv,txt,rtf,odt,ods,odp,png,jpg,jpeg,gif,tif,tiff,webp,zip,7z,gz,tar,xml,json,eml,msg,dwg,dxf
UPLOAD_URL_TTL_SECONDS=900                   # lifetime of each pre-signed upload URL
UPLOAD_SESSION_TTL_SECONDS=86400             # abandoned uploads are cleaned up after this
DOWNLOAD_URL_TTL_SECONDS=300                 # pre-signed download URL lifetime (5 minutes)
DELETED_DOCUMENT_RETENTION_DAYS=30           # deleted documents are recoverable for this long, then purged

# --- Background maintenance ---------------------------------------------------
# Run maintenance in-process, or leave false and schedule `npm run jobs -- maintenance` via cron/systemd.
JOBS_ENABLED=false
JOBS_INTERVAL_SECONDS=900

# --- Email (password reset and invitations) -----------------------------------
MAIL_DRIVER=disabled                 # smtp | console (development only) | disabled
MAIL_FROM=Tekpro Document Portal <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# When true, the Super Admin sees single-use invitation/reset links in the UI so they can
# be shared out-of-band (useful before SMTP is configured). Keep false where email works.
ALLOW_ADMIN_RESET_LINKS=false

# --- Bootstrap (one-time, optional) ------------------------------------------
# Only read by `npm run bootstrap:superadmin` when no TTY is available. Unset it afterwards.
# BOOTSTRAP_SUPERADMIN_PASSWORD=
