{
  "name": "@tekpro/portal-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:status": "node --env-file-if-exists=../.env ../node_modules/prisma/build/index.js migrate status",
    "bootstrap:superadmin": "tsx --env-file-if-exists=../.env src/cli/bootstrapSuperAdmin.ts",
    "bootstrap:superadmin:prod": "node --env-file-if-exists=../.env dist/cli/bootstrapSuperAdmin.js",
    "storage:check": "tsx --env-file-if-exists=../.env src/cli/storageCheck.ts",
    "storage:check:prod": "node --env-file-if-exists=../.env dist/cli/storageCheck.js",
    "jobs": "tsx --env-file-if-exists=../.env src/cli/runJobs.ts",
    "jobs:prod": "node --env-file-if-exists=../.env dist/cli/runJobs.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storage-integration": "vitest run --config vitest.storage.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
